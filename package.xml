<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coverage</name>
  <version>0.2.0</version>
  <description>BLE cleaning-zone polygon to Nav2 complete coverage (opennav_coverage bridge)</description>
  <maintainer email="6kam465@gmail.com">6kam</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>
  <depend>opennav_coverage_msgs</depend>

  <exec_depend>mirs</exec_depend>
  <exec_depend>ble_server</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>fields2cover</exec_depend>
  <exec_depend>opennav_coverage</exec_depend>
  <exec_depend>opennav_coverage_navigator</exec_depend>
  <exec_depend>opennav_coverage_bt</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
